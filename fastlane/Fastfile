default_platform(:ios)

API_KEY_PATH = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_8AQ38HX67R.p8")
KEY_ID = "8AQ38HX67R"
ISSUER_ID = "f75dec40-cdbc-4042-8faa-de413470def6"

def asc_api_key
  app_store_connect_api_key(
    key_id: KEY_ID,
    issuer_id: ISSUER_ID,
    key_filepath: API_KEY_PATH,
    duration: 1200,
    in_house: false
  )
end

platform :ios do

  # ============================================================
  # 接続テスト: ASC API key の疎通確認（副作用なし、読み取りのみ）
  # ============================================================
  desc "ASC API key で接続テスト（既存アプリ一覧取得・副作用なし）"
  lane :test_connection do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID,
      issuer_id: ISSUER_ID,
      filepath: API_KEY_PATH
    )

    apps = Spaceship::ConnectAPI::App.all
    UI.message("==== ASC 接続成功 ====")
    UI.message("総アプリ数: #{apps.count}")
    apps.each do |app|
      UI.message("  - #{app.bundle_id} (#{app.name})")
    end

    # AdblockKeshi が既に存在するかチェック
    existing = apps.find { |a| a.bundle_id == "com.kureho.adblockkeshi" }
    if existing
      UI.important("⚠️  com.kureho.adblockkeshi は既に登録済: app_id=#{existing.id}")
    else
      UI.success("✓ com.kureho.adblockkeshi は未登録、produce 可能")
    end
  end

  # ============================================================
  # 不可逆: bundle id 登録のみ（ASC アプリ作成は Web UI 手動・後述）
  # ASC API は 'apps' リソースに対する CREATE をサポートしないため
  # ============================================================
  desc "[不可逆] bundle id 登録 (ASC API 経由・2FA不要)"
  lane :register_bundle_ids do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID,
      issuer_id: ISSUER_ID,
      filepath: API_KEY_PATH
    )

    %w[com.kureho.adblockkeshi com.kureho.adblockkeshi.blocker].each do |bundle_id|
      existing = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == bundle_id }
      if existing
        UI.message("✓ bundle id 既存: #{bundle_id} (id=#{existing.id})")
      else
        name = bundle_id == "com.kureho.adblockkeshi" ? "AdblockKeshi" : "AdblockKeshi ContentBlocker"
        Spaceship::ConnectAPI::BundleId.create(
          name: name,
          identifier: bundle_id,
          platform: "IOS",
          seed_id: "L455WPL8QZ"
        )
        UI.success("✓ bundle id 新規作成: #{bundle_id}")
      end
    end

    UI.message("")
    UI.message("==== 次に kureho の手動操作 (約30秒) ====")
    UI.message("ASC Web UI で新規アプリ作成:")
    UI.message("  https://appstoreconnect.apple.com/apps")
    UI.message("  → 「+」ボタン → 新規 App → iOS")
    UI.message("  - 名前: 広告消し")
    UI.message("  - 主要言語: 日本語")
    UI.message("  - バンドルID: com.kureho.adblockkeshi (上記で登録済)")
    UI.message("  - SKU: com.kureho.adblockkeshi.sku.001")
    UI.message("  - ユーザーアクセス: 限定アクセス")
  end

  # ============================================================
  # Build & TestFlight upload
  # ============================================================
  desc "Build, archive, upload to TestFlight"
  lane :beta do
    sh "cd .. && xcodegen generate"

    build_app(
      project: "AdblockKeshi.xcodeproj",
      scheme: "AdblockKeshi",
      export_method: "app-store",
      output_directory: "build",
      clean: true,
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: asc_api_key,
      skip_waiting_for_build_processing: false,
      changelog: "v0.2.0-plan-b 完了。Plan A+B 統合動作確認版。"
    )
  end

  # ============================================================
  # Metadata 送信（テキスト系のみ、スクショ・バイナリは別フェーズ）
  # ============================================================
  desc "Submit text metadata only (no screenshots, no binary, no review submission)"
  lane :submit_metadata do
    deliver(
      api_key: asc_api_key,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_screenshots: true,
      skip_metadata: false,
      skip_binary_upload: true,
      price_tier: 4,
      reset_ratings: false,
      run_precheck_before_submit: false
    )
  end

  desc "Submit screenshots only (after generation)"
  lane :submit_screenshots do
    deliver(
      api_key: asc_api_key,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_screenshots: false,
      skip_metadata: true,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      run_precheck_before_submit: false
    )
  end

  # ============================================================
  # 4点監査（feedback_apple_submission_state_audit）
  # ============================================================
  desc "Run 4-point audit (review/availability/price/IAP)"
  lane :audit do
    sh "python3 ../../tasks/scripts/audit_4points.py com.kureho.adblockkeshi || true"
  end

  desc "Clone Review Information from an existing app (StillCam) to AdblockKeshi"
  lane :clone_review_info do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )

    # Source: StillCam 4K (id=6760555855) の最新 version の Review Detail
    source_app = Spaceship::ConnectAPI::App.find("com.Kureho.MannerCamera4K")
    UI.user_error!("source app not found") unless source_app
    src_versions = source_app.get_app_store_versions
    src_target = src_versions.find { |v| v.app_store_state == "READY_FOR_SALE" } || src_versions.first
    src_detail = src_target.fetch_app_store_review_detail
    UI.message("Source review detail (StillCam):")
    UI.message("  email: #{src_detail.contact_email}")
    UI.message("  phone: #{src_detail.contact_phone[0..2]}***#{src_detail.contact_phone[-2..-1]} (masked)")
    UI.message("  first: #{src_detail.contact_first_name}")
    UI.message("  last:  #{src_detail.contact_last_name}")

    # Target: AdblockKeshi
    target_app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    target_versions = target_app.get_app_store_versions
    target_v = target_versions.find { |v| v.app_store_state == "PREPARE_FOR_SUBMISSION" } || target_versions.first
    UI.user_error!("editable version not found") unless target_v

    attrs = {
      contactFirstName: src_detail.contact_first_name,
      contactLastName: src_detail.contact_last_name,
      contactEmail: src_detail.contact_email,
      contactPhone: src_detail.contact_phone,
      demoAccountRequired: false,
      notes: "本アプリは Safari Content Blocker です。Safari 設定 > 機能拡張 > 「広告消し」を ON にして adblock-tester.com を開くと広告ブロック動作が確認できます。アプリ内画面は最小構成で、設定項目はありません。"
    }

    begin
      existing = target_v.fetch_app_store_review_detail
      existing.update(attributes: attrs)
      UI.success("✓ Review Information updated (existing)")
    rescue => e
      # 新規作成: Tunes クライアント経由で raw POST
      UI.message("Existing not found (#{e.message[0..100]}). Creating new via Tunes client...")
      body = {
        data: {
          type: "appStoreReviewDetails",
          attributes: attrs,
          relationships: {
            appStoreVersion: {
              data: { type: "appStoreVersions", id: target_v.id }
            }
          }
        }
      }
      Spaceship::ConnectAPI::Tunes.client.post("appStoreReviewDetails", body)
      UI.success("✓ Review Information created (Tunes raw POST)")
    end
  end

  desc "Set Primary Category (UTILITIES)"
  lane :set_category do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )
    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    app_info = app.fetch_edit_app_info || app.fetch_live_app_info
    UI.user_error!("app_info not found") unless app_info

    # Primary Category = UTILITIES
    app_info.update_categories(
      primary_category_id: "UTILITIES"
    )
    UI.success("✓ Primary Category = UTILITIES")
  end

  desc "Set Price (¥400 = price point JPY 400)"
  lane :set_price do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )
    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")

    # 新しい価格 API: AppPricePoint / AppPriceSchedule
    # ¥400 = USD$2.99 相当 = tier 3 相当 (旧)
    # 直接 fastlane action を使う
    versions = app.get_app_store_versions
    target = versions.find { |v| v.app_store_state == "PREPARE_FOR_SUBMISSION" } || versions.first
    UI.message("Setting price for version #{target.version_string}...")

    # ASC Web UI で行う方が確実な領域なので注意ログ
    UI.important("価格設定は ASC Web UI 推奨。fastlane deliver の price_tier 4 (=¥400) を使うか、ASC で手動設定")
    UI.message("https://appstoreconnect.apple.com/apps/#{app.id}/pricing")
  end

  desc "TestFlight build 1.0.0(3) を AppStoreVersion v1.0 に attach"
  lane :attach_build do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )
    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    token_text = Spaceship::ConnectAPI.token.text
    require 'json'

    # 利用可能な build (最新)
    builds = app.get_builds(limit: 5, sort: "-uploadedDate")
    build = builds.find { |b| b.processing_state == "VALID" } || builds.first
    UI.user_error!("VALID build not found") unless build
    UI.message("Attaching build #{build.version} (#{build.processing_state})...")

    # 輸出コンプライアンス補完 (nil なら false)
    if build.uses_non_exempt_encryption.nil?
      build.update(attributes: { usesNonExemptEncryption: false })
      sleep 2
      UI.message("  uses_non_exempt_encryption: nil → false")
    end

    # version
    versions = app.get_app_store_versions(limit: 3)
    target = versions.find { |v| v.app_store_state == "PREPARE_FOR_SUBMISSION" }
    UI.user_error!("editable version not found") unless target

    # PATCH /v1/appStoreVersions/{id}/relationships/build
    body = { data: { type: "builds", id: build.id } }
    File.write("/tmp/attach-body.json", JSON.generate(body))
    res = `curl -sS -X PATCH "https://api.appstoreconnect.apple.com/v1/appStoreVersions/#{target.id}/relationships/build" \
      -H "Authorization: Bearer #{token_text}" \
      -H "Content-Type: application/json" \
      --data-binary @/tmp/attach-body.json -w "\\nHTTP_STATUS:%{http_code}"`
    UI.message("Response: #{res[0..300]}")
    if res =~ /HTTP_STATUS:(200|204)/
      UI.success("✓ Build attached")
    else
      UI.error("✗ attach failed")
    end
  end

  desc "Set App Availability to all territories"
  lane :set_territories do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )
    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    token_text = Spaceship::ConnectAPI.token.text
    require 'json'

    # 利用可能な territories リスト
    UI.message("Fetching all territories...")
    terr_res = `curl -sS "https://api.appstoreconnect.apple.com/v1/territories?limit=200" -H "Authorization: Bearer #{token_text}"`
    terr_p = JSON.parse(terr_res)
    territory_ids = terr_p['data'].map { |t| t['id'] }
    UI.message("  total territories: #{territory_ids.size}")

    # availability request: 全地域 + availableInNewTerritories: true
    # ASC v2 仕様: territoryAvailabilities sub-resource 経由
    included_arr = territory_ids.map.with_index do |id, idx|
      {
        type: "territoryAvailabilities",
        id: "${ta#{idx}}",
        attributes: { available: true },
        relationships: { territory: { data: { type: "territories", id: id } } }
      }
    end
    avail_body = {
      data: {
        type: "appAvailabilities",
        attributes: { availableInNewTerritories: true },
        relationships: {
          app: { data: { type: "apps", id: app.id } },
          territoryAvailabilities: {
            data: included_arr.map { |ta| { type: "territoryAvailabilities", id: ta[:id] } }
          }
        }
      },
      included: included_arr
    }
    File.write("/tmp/avail-body.json", JSON.generate(avail_body))
    # 既存 availability id を v2 / v1 両方で探索
    cur_id = nil
    %w[v2 v1].each do |ver|
      cur_res = `curl -sS "https://api.appstoreconnect.apple.com/#{ver}/apps/#{app.id}/appAvailability" -H "Authorization: Bearer #{token_text}"`
      UI.message("  #{ver}/appAvailability response (first 200): #{cur_res[0..200]}")
      cur = JSON.parse(cur_res) rescue {}
      cur_id = cur.dig('data', 'id')
      break if cur_id
    end
    # v1 V2 sub-resource も試行
    if cur_id.nil?
      cur_res = `curl -sS "https://api.appstoreconnect.apple.com/v1/apps/#{app.id}/appAvailabilityV2" -H "Authorization: Bearer #{token_text}"`
      UI.message("  v1/appAvailabilityV2 response (first 200): #{cur_res[0..200]}")
      cur = JSON.parse(cur_res) rescue {}
      cur_id = cur.dig('data', 'id')
    end
    UI.message("既存 availability id: #{cur_id || 'なし'}")

    if cur_id
      # PATCH 既存
      avail_body[:data][:id] = cur_id
      File.write("/tmp/avail-body.json", JSON.generate(avail_body))
      res = `curl -sS -X PATCH "https://api.appstoreconnect.apple.com/v2/appAvailabilities/#{cur_id}" \
        -H "Authorization: Bearer #{token_text}" \
        -H "Content-Type: application/json" \
        --data-binary @/tmp/avail-body.json -w "\\nHTTP_STATUS:%{http_code}"`
    else
      res = `curl -sS -X POST "https://api.appstoreconnect.apple.com/v2/appAvailabilities" \
        -H "Authorization: Bearer #{token_text}" \
        -H "Content-Type: application/json" \
        --data-binary @/tmp/avail-body.json -w "\\nHTTP_STATUS:%{http_code}"`
    end
    UI.message("Response: #{res[0..500]}")
    if res =~ /HTTP_STATUS:(200|201|204)/
      UI.success("✓ All #{territory_ids.size} territories enabled")
    else
      UI.error("✗ Availability set failed")
    end
  end

  desc "Set Secondary Category PRODUCTIVITY"
  lane :set_secondary_category do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )
    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    token_text = Spaceship::ConnectAPI.token.text
    require 'json'

    info_res = `curl -sS "https://api.appstoreconnect.apple.com/v1/apps/#{app.id}/appInfos" -H "Authorization: Bearer #{token_text}"`
    info_p = JSON.parse(info_res)
    info = info_p['data'].find { |i| %w[PREPARE_FOR_SUBMISSION].include?(i.dig('attributes', 'appStoreState')) } || info_p['data'].first

    body = {
      data: {
        id: info['id'],
        type: "appInfos",
        relationships: {
          secondaryCategory: { data: { type: "appCategories", id: "PRODUCTIVITY" } }
        }
      }
    }
    File.write("/tmp/scat-body.json", JSON.generate(body))
    res = `curl -sS -X PATCH "https://api.appstoreconnect.apple.com/v1/appInfos/#{info['id']}" \
      -H "Authorization: Bearer #{token_text}" \
      -H "Content-Type: application/json" \
      --data-binary @/tmp/scat-body.json -w "\\nHTTP_STATUS:%{http_code}"`
    UI.message("Response: #{res[0..300]}")
    if res =~ /HTTP_STATUS:(200|204)/
      UI.success("✓ Secondary Category = PRODUCTIVITY")
    else
      UI.error("✗ Secondary Category failed")
    end
  end

  desc "Patch promotional_text + extended description + keywords"
  lane :patch_promo_desc_kw do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )
    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    target = app.get_app_store_versions(limit: 3).find { |v| v.app_store_state == "PREPARE_FOR_SUBMISSION" }
    ja = target.get_app_store_version_localizations.find { |l| l.locale == "ja" }
    promo = File.read("metadata/ja/promotional_text.txt").strip
    desc = File.read("metadata/ja/description.txt").strip
    kw = File.read("metadata/ja/keywords.txt").strip
    UI.message("promo: #{promo.length} (170max), desc: #{desc.length} (4000max), kw: #{kw.length} (100max)")
    UI.user_error!("promo > 170") if promo.length > 170
    UI.user_error!("kw > 100") if kw.length > 100
    ja.update(attributes: {
      promotionalText: promo,
      description: desc,
      keywords: kw
    })
    UI.success("✓ promo/desc/keywords 更新完了")
  end

  desc "AdblockKeshi vs 他アプリの全メタデータ差分監査"
  lane :compare_with_other_apps do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )
    token = Spaceship::ConnectAPI.token.text
    require 'json'

    apps = Spaceship::ConnectAPI::App.all
    UI.message("=== 全アプリ メタデータ比較 ===\n")

    apps.each do |app|
      bundle_short = app.bundle_id.sub(/^com\.[Kk]ureho\.?/, "")
      puts "----- #{bundle_short.ljust(25)} (#{app.name}) -----"

      # AppInfo
      info_res = `curl -sS "https://api.appstoreconnect.apple.com/v1/apps/#{app.id}/appInfos?include=primaryCategory,secondaryCategory" -H "Authorization: Bearer #{token}"`
      info_p = JSON.parse(info_res) rescue {}
      info = info_p['data']&.find { |i| %w[PREPARE_FOR_SUBMISSION].include?(i.dig('attributes', 'appStoreState')) } || info_p['data']&.first
      primary = info&.dig('relationships', 'primaryCategory', 'data', 'id') || "-"
      secondary = info&.dig('relationships', 'secondaryCategory', 'data', 'id') || "-"

      # AppInfoLocalization (ja) → name / subtitle / privacy policy URL
      loc_res = `curl -sS "https://api.appstoreconnect.apple.com/v1/appInfos/#{info['id']}/appInfoLocalizations" -H "Authorization: Bearer #{token}"` rescue ""
      loc_p = JSON.parse(loc_res) rescue {}
      ja_info = loc_p['data']&.find { |l| l.dig('attributes', 'locale') == "ja" }
      name = ja_info&.dig('attributes', 'name') || "-"
      subtitle = ja_info&.dig('attributes', 'subtitle') || "-"
      pp_url = ja_info&.dig('attributes', 'privacyPolicyUrl') || "-"

      # AppStoreVersion (latest editable or live) → description/keywords/marketingUrl/supportUrl/promotionalText
      vers = app.get_app_store_versions(limit: 3)
      v = vers.find { |x| %w[PREPARE_FOR_SUBMISSION WAITING_FOR_REVIEW READY_FOR_SALE].include?(x.app_store_state) } || vers.first
      vja = v&.get_app_store_version_localizations&.find { |l| l.locale == "ja" }
      desc_len = (vja&.description || "").length
      kw = vja&.keywords || ""
      kw_len = kw.length
      promo = vja&.promotional_text || ""
      promo_len = promo.length
      mkt_url = vja&.marketing_url || "-"
      sup_url = vja&.support_url || "-"

      puts "  name       : #{name} (#{name.length} chars)"
      puts "  subtitle   : #{subtitle}"
      puts "  primary    : #{primary} / secondary: #{secondary}"
      puts "  description: #{desc_len} chars"
      puts "  keywords   : #{kw_len} chars: #{kw[0..60]}..."
      puts "  promo_text : #{promo_len} chars: #{promo[0..60]}"
      puts "  mkt_url    : #{mkt_url}"
      puts "  sup_url    : #{sup_url}"
      puts "  pp_url(loc): #{pp_url}"
      puts ""
    end
  end

  desc "Update App Store name (with ASO suffix) via ASC API"
  lane :patch_app_name do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )
    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    token_text = Spaceship::ConnectAPI.token.text
    require 'json'

    new_name = "広告消し - Safari広告ブロック・アドブロック"
    UI.message("New name: '#{new_name}' (#{new_name.length} chars)")
    UI.user_error!("name exceeds 30 chars") if new_name.length > 30

    # AppInfo → AppInfoLocalization (ja) の id を取得
    info_res = `curl -sS "https://api.appstoreconnect.apple.com/v1/apps/#{app.id}/appInfos" -H "Authorization: Bearer #{token_text}"`
    info_p = JSON.parse(info_res)
    info = info_p['data'].find { |i| %w[PREPARE_FOR_SUBMISSION].include?(i.dig('attributes', 'appStoreState')) } || info_p['data'].first

    loc_res = `curl -sS "https://api.appstoreconnect.apple.com/v1/appInfos/#{info['id']}/appInfoLocalizations" -H "Authorization: Bearer #{token_text}"`
    loc_p = JSON.parse(loc_res)
    ja_loc = loc_p['data'].find { |l| l.dig('attributes', 'locale') == "ja" }
    UI.user_error!("ja localization not found") unless ja_loc
    UI.message("ja localization id: #{ja_loc['id']}")

    # PATCH /v1/appInfoLocalizations/{id}
    body = {
      data: {
        id: ja_loc['id'],
        type: "appInfoLocalizations",
        attributes: { name: new_name }
      }
    }
    File.write("/tmp/name-body.json", JSON.generate(body))
    res = `curl -sS -X PATCH "https://api.appstoreconnect.apple.com/v1/appInfoLocalizations/#{ja_loc['id']}" \
      -H "Authorization: Bearer #{token_text}" \
      -H "Content-Type: application/json" \
      --data-binary @/tmp/name-body.json -w "\\nHTTP_STATUS:%{http_code}"`
    UI.message("Response: #{res[0..400]}")
    if res =~ /HTTP_STATUS:(200|204)/
      UI.success("✓ App name updated to '#{new_name}'")
    else
      UI.error("✗ name update failed")
    end
  end

  desc "提出前全項目監査 (feedback_apple_submission_state_audit 4点 + 必須メタデータ)"
  lane :pre_submit_audit do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )
    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    token_text = Spaceship::ConnectAPI.token.text
    require 'json'

    issues = []
    ok = []
    APP_ID = app.id

    # 1. version state + build attached
    UI.message("=== ① version + build ===")
    versions = app.get_app_store_versions(limit: 3)
    target = versions.find { |v| v.app_store_state == "PREPARE_FOR_SUBMISSION" }
    if target.nil?
      issues << "editable version (PREPARE_FOR_SUBMISSION) not found"
    else
      UI.message("  version: v#{target.version_string} state=#{target.app_store_state}")
      ok << "version v#{target.version_string} editable"

      # build attached?
      build_res = `curl -sS "https://api.appstoreconnect.apple.com/v1/appStoreVersions/#{target.id}/build" -H "Authorization: Bearer #{token_text}"`
      bp = JSON.parse(build_res) rescue { 'data' => nil }
      if bp.dig('data', 'id')
        UI.message("  build attached: #{bp.dig('data', 'id')}")
        ok << "build attached"
      else
        issues << "BUILD NOT ATTACHED to version v#{target.version_string} → 提出不可"
      end
    end

    # 2. screenshots
    UI.message("=== ② screenshots ===")
    locs = target&.get_app_store_version_localizations || []
    ja = locs.find { |l| l.locale == "ja" }
    if ja
      ss_res = `curl -sS "https://api.appstoreconnect.apple.com/v1/appStoreVersionLocalizations/#{ja.id}/appScreenshotSets?include=appScreenshots" -H "Authorization: Bearer #{token_text}"`
      ssp = JSON.parse(ss_res) rescue { 'data' => [] }
      total_ss = ssp.dig('included')&.count { |i| i['type'] == 'appScreenshots' } || 0
      UI.message("  screenshot total: #{total_ss}")
      if total_ss >= 3
        ok << "screenshots: #{total_ss}"
      else
        issues << "screenshots: #{total_ss} (Apple は iPhone 6.9 で最低3枚必須)"
      end
    end

    # 3. metadata 必須項目
    UI.message("=== ③ metadata text ===")
    if ja
      ml = ja.attributes if ja.respond_to?(:attributes)
      desc_len = (ja.description || '').length
      kw_len = (ja.keywords || '').length
      UI.message("  description len=#{desc_len}, keywords len=#{kw_len}")
      ok << "description (#{desc_len} chars)" if desc_len >= 10
      issues << "description too short (#{desc_len})" if desc_len < 10
      ok << "keywords (#{kw_len} chars)" if kw_len >= 5
      issues << "keywords too short (#{kw_len})" if kw_len < 5
    end

    # 4. AppInfo: category / age rating
    UI.message("=== ④ AppInfo (category / age rating) ===")
    info_res = `curl -sS "https://api.appstoreconnect.apple.com/v1/apps/#{APP_ID}/appInfos?include=primaryCategory,ageRatingDeclaration" -H "Authorization: Bearer #{token_text}"`
    info_p = JSON.parse(info_res)
    info = info_p['data']&.find { |i| %w[PREPARE_FOR_SUBMISSION].include?(i.dig('attributes', 'appStoreState')) } || info_p['data']&.first

    primary_cat = info.dig('relationships', 'primaryCategory', 'data', 'id')
    if primary_cat
      ok << "Primary Category: #{primary_cat}"
    else
      issues << "Primary Category NOT SET"
    end

    age_rating_id = info.dig('relationships', 'ageRatingDeclaration', 'data', 'id')
    if age_rating_id
      ok << "Age Rating set (id=#{age_rating_id})"
    else
      issues << "Age Rating NOT SET"
    end

    # 5. Review Information
    UI.message("=== ⑤ Review Information ===")
    begin
      rd = target.fetch_app_store_review_detail
      if rd && rd.contact_email
        UI.message("  Email: #{rd.contact_email} / First: #{rd.contact_first_name}")
        if rd.contact_email == "info@kureho.app" && rd.contact_first_name == "Kureho"
          ok << "Review Info (法人版)"
        else
          issues << "Review Info NOT corp (個人情報のまま): #{rd.contact_first_name}/#{rd.contact_email}"
        end
      else
        issues << "Review Information NOT SET"
      end
    rescue => e
      issues << "Review Info error: #{e.message[0..80]}"
    end

    # 6. ⚠ 重要: Pricing & Availability (4点監査ルール)
    UI.message("=== ⑥ Pricing & Availability ===")
    # 6a. price schedule
    price_res = `curl -sS "https://api.appstoreconnect.apple.com/v1/apps/#{APP_ID}/appPriceSchedule?include=manualPrices,baseTerritory" -H "Authorization: Bearer #{token_text}"`
    pp = JSON.parse(price_res) rescue { 'data' => nil }
    if pp.dig('data', 'id')
      ok << "Price Schedule set"
    else
      issues << "Price Schedule NOT SET → 提出時に price tier 不明エラー"
    end

    # 6b. App Availability (Territories) — v2 endpoint
    avail_res = `curl -sS "https://api.appstoreconnect.apple.com/v2/apps/#{APP_ID}/appAvailability?include=territoryAvailabilities&limit=200" -H "Authorization: Bearer #{token_text}"`
    av = JSON.parse(avail_res) rescue { 'data' => nil }
    available_new = av.dig('data', 'attributes', 'availableInNewTerritories')
    terr_avails = av['included']&.select { |i| i['type'] == 'territoryAvailabilities' } || []
    available_count = terr_avails.count { |ta| ta.dig('attributes', 'available') == true }
    UI.message("  territoryAvailabilities total: #{terr_avails.size} (available=#{available_count})")
    UI.message("  availableInNewTerritories: #{available_new}")
    if available_count >= 1
      ok << "Territories (#{available_count}/#{terr_avails.size} 地域 available, availableInNewTerritories=#{available_new})"
    else
      issues << "⚠⚠⚠ Territories EMPTY → 審査通過後も配信されない事故 (feedback_apple_submission_state_audit)"
    end

    # 7. App Privacy
    UI.message("=== ⑦ App Privacy ===")
    privacy_res = `curl -sS "https://api.appstoreconnect.apple.com/v1/apps/#{APP_ID}/appPrivacyDetails" -H "Authorization: Bearer #{token_text}"`
    pd = JSON.parse(privacy_res) rescue { 'data' => nil }
    UI.message("  Response (first 300): #{privacy_res[0..300]}")
    if privacy_res.include?('"data"') && !privacy_res.include?('"data" : null')
      ok << "App Privacy declaration submitted"
    else
      issues << "⚠ App Privacy NOT SET (kureho が ASC Web UI で「データを収集していません」選択必要)"
    end

    UI.message("")
    UI.message("========== 監査結果 ==========")
    UI.success("✓ OK (#{ok.count} 項目)")
    ok.each { |o| UI.message("  ✓ #{o}") }
    if issues.any?
      UI.error("✗ ISSUES (#{issues.count} 項目)")
      issues.each { |i| UI.error("  ✗ #{i}") }
    else
      UI.success("🎉 全項目クリア・提出可能")
    end
  end

  desc "Set Price ¥400 via raw ASC API (appPriceSchedules)"
  lane :set_price_raw do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )
    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    token_text = Spaceship::ConnectAPI.token.text
    require 'json'

    # まず JPN 領域で ¥400 相当の appPricePoint を検索
    UI.message("Looking for ¥400 priceTier in JPN territory...")
    # priceTier 4 が ¥400 相当（過去 fastlane deliver で使用）
    # ASC API の新形式: appPricePoints は他アプリの price point id を経由する必要
    # 別アプリ (StillCam 4K) で ¥400 相当の price point id を取得して流用

    stillcam = Spaceship::ConnectAPI::App.find("com.Kureho.MannerCamera4K")
    res = `curl -sS "https://api.appstoreconnect.apple.com/v1/apps/#{stillcam.id}/appPricePoints?limit=200&filter%5Bterritory%5D=JPN" \
      -H "Authorization: Bearer #{token_text}"`
    parsed = JSON.parse(res)
    pp_jpn_400 = parsed['data']&.find do |pp|
      cp = pp.dig('attributes', 'customerPrice')&.to_f
      cp == 400.0
    end

    if pp_jpn_400.nil?
      UI.error("¥400 price point not found in StillCam. Sample:")
      parsed['data']&.first(3)&.each { |p| UI.message("  #{p.dig('attributes', 'customerPrice')} #{p.dig('attributes', 'territory') || ''}") }
      next
    end

    base_pp_id = pp_jpn_400['id']
    UI.message("Found ¥400 price point id=#{base_pp_id}")

    # AdblockKeshi 用の同じ priceTier の price point を取得する必要
    res2 = `curl -sS "https://api.appstoreconnect.apple.com/v1/apps/#{app.id}/appPricePoints?limit=200&filter%5Bterritory%5D=JPN" \
      -H "Authorization: Bearer #{token_text}"`
    parsed2 = JSON.parse(res2)
    target_pp = parsed2['data']&.find do |pp|
      pp.dig('attributes', 'customerPrice')&.to_f == 400.0
    end
    UI.user_error!("AdblockKeshi 用の ¥400 price point not found") unless target_pp
    target_pp_id = target_pp['id']
    UI.message("AdblockKeshi ¥400 price point id=#{target_pp_id}")

    # appPriceSchedules 作成
    body = {
      data: {
        type: "appPriceSchedules",
        relationships: {
          app: { data: { type: "apps", id: app.id } },
          manualPrices: {
            data: [
              { type: "appPrices", id: "${new-price}" }
            ]
          },
          baseTerritory: { data: { type: "territories", id: "JPN" } }
        }
      },
      included: [
        {
          id: "${new-price}",
          type: "appPrices",
          attributes: { startDate: nil },
          relationships: {
            appPricePoint: { data: { type: "appPricePoints", id: target_pp_id } }
          }
        }
      ]
    }
    File.write("/tmp/price-body.json", JSON.generate(body))
    res3 = `curl -sS -X POST "https://api.appstoreconnect.apple.com/v1/appPriceSchedules" \
      -H "Authorization: Bearer #{token_text}" \
      -H "Content-Type: application/json" \
      --data-binary @/tmp/price-body.json -w "\\nHTTP_STATUS:%{http_code}"`
    UI.message("Response: #{res3[0..500]}")
    if res3 =~ /HTTP_STATUS:(200|201|204)/
      UI.success("✓ Price ¥400 set")
    else
      UI.error("✗ Price set failed")
    end
  end

  desc "Set Primary Category UTILITIES via raw ASC API"
  lane :set_category_raw do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )
    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    token_text = Spaceship::ConnectAPI.token.text

    # AppInfo の取得 (editable な最新)
    result = `curl -sS "https://api.appstoreconnect.apple.com/v1/apps/#{app.id}/appInfos" \
      -H "Authorization: Bearer #{token_text}"`
    require 'json'
    parsed = JSON.parse(result)
    UI.message("AppInfos count: #{parsed['data']&.count}")
    parsed['data']&.each do |info|
      UI.message("  - id=#{info['id']} state=#{info.dig('attributes', 'appStoreState')}")
    end

    # editable な appInfo を選ぶ (PREPARE_FOR_SUBMISSION 等)
    info = parsed['data']&.find { |i| %w[PREPARE_FOR_SUBMISSION WAITING_FOR_REVIEW IN_REVIEW REJECTED].include?(i.dig('attributes', 'appStoreState')) }
    info ||= parsed['data']&.first
    UI.user_error!("editable appInfo not found") unless info

    info_id = info['id']
    UI.message("Patching appInfo id=#{info_id}...")

    # 正しい方法: PATCH /v1/appInfos/{id} 本体の relationships を直接更新
    body = {
      data: {
        id: info_id,
        type: "appInfos",
        relationships: {
          primaryCategory: { data: { type: "appCategories", id: "UTILITIES" } }
        }
      }
    }
    File.write("/tmp/cat-body.json", JSON.generate(body))
    res = `curl -sS -X PATCH "https://api.appstoreconnect.apple.com/v1/appInfos/#{info_id}" \
      -H "Authorization: Bearer #{token_text}" \
      -H "Content-Type: application/json" \
      --data-binary @/tmp/cat-body.json -w "\\nHTTP_STATUS:%{http_code}"`
    UI.message("Response: #{res[0..500]}")
    if res.include?("HTTP_STATUS:204") || res.include?("HTTP_STATUS:200")
      UI.success("✓ Primary Category = UTILITIES")
    else
      UI.error("✗ Category set failed")
    end
  end

  desc "Set Age Rating (4+) via raw ASC API"
  lane :set_age_rating_raw do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )
    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    token_text = Spaceship::ConnectAPI.token.text
    require 'json'

    # AppInfo を取得して ageRatingDeclaration を見る
    result = `curl -sS "https://api.appstoreconnect.apple.com/v1/apps/#{app.id}/appInfos?include=ageRatingDeclaration" \
      -H "Authorization: Bearer #{token_text}"`
    parsed = JSON.parse(result)

    # editable appInfo
    info = parsed['data']&.find { |i| %w[PREPARE_FOR_SUBMISSION WAITING_FOR_REVIEW IN_REVIEW REJECTED].include?(i.dig('attributes', 'appStoreState')) }
    info ||= parsed['data']&.first
    UI.user_error!("editable appInfo not found") unless info

    rating_rel = info.dig('relationships', 'ageRatingDeclaration', 'data')
    UI.message("ageRatingDeclaration: #{rating_rel.inspect}")

    # ageRatingDeclaration が存在するかチェック → なければ作成、あれば PATCH
    rating_attrs = {
      alcoholTobaccoOrDrugUseOrReferences: "NONE",
      contests: "NONE",
      gamblingSimulated: "NONE",
      medicalOrTreatmentInformation: "NONE",
      profanityOrCrudeHumor: "NONE",
      sexualContentGraphicAndNudity: "NONE",
      sexualContentOrNudity: "NONE",
      horrorOrFearThemes: "NONE",
      matureOrSuggestiveThemes: "NONE",
      unrestrictedWebAccess: false,
      gambling: false,
      violenceCartoonOrFantasy: "NONE",
      violenceRealistic: "NONE",
      violenceRealisticProlongedGraphicOrSadistic: "NONE",
      userGeneratedContent: false
    }

    # エラーループで不足 attribute を自動補完 (最大 30 trial)
    rating_id = rating_rel&.[]('id')
    success = false
    30.times do |trial|
      if rating_id
        body = { data: { id: rating_id, type: "ageRatingDeclarations", attributes: rating_attrs } }
        url = "https://api.appstoreconnect.apple.com/v1/ageRatingDeclarations/#{rating_id}"
        method = "PATCH"
      else
        body = {
          data: {
            type: "ageRatingDeclarations",
            attributes: rating_attrs,
            relationships: { appInfo: { data: { type: "appInfos", id: info['id'] } } }
          }
        }
        url = "https://api.appstoreconnect.apple.com/v1/ageRatingDeclarations"
        method = "POST"
      end
      File.write("/tmp/age-body.json", JSON.generate(body))
      res = `curl -sS -X #{method} "#{url}" \
        -H "Authorization: Bearer #{token_text}" \
        -H "Content-Type: application/json" \
        --data-binary @/tmp/age-body.json -w "\\nHTTP_STATUS:%{http_code}"`

      if res =~ /HTTP_STATUS:(200|201|204)/
        UI.success("✓ Age Rating success (trial #{trial + 1}, attrs=#{rating_attrs.keys.size})")
        success = true
        break
      end

      # 不足 attribute を解析
      if res =~ /You must provide a value for the attribute '([^']+)'/
        missing = $1
        # デフォルト値: 名前から推測 (大抵 ENUM 'NONE' か BOOLEAN false)
        # 後で BOOLEAN error が出たら false に切替
        rating_attrs[missing.to_sym] = "NONE"
        UI.message("  trial #{trial + 1}: adding '#{missing}' = NONE")
      elsif res =~ /Unexpected json type provided for attribute '([^']+)'. Expected a (BOOLEAN|INTEGER)/
        attr = $1
        type = $2
        rating_attrs[attr.to_sym] = (type == "BOOLEAN") ? false : 0
        UI.message("  trial #{trial + 1}: '#{attr}' → #{type}")
      elsif res =~ /'([^']+)' is not an attribute on the resource/
        attr = $1
        rating_attrs.delete(attr.to_sym)
        UI.message("  trial #{trial + 1}: removed unknown '#{attr}'")
      else
        UI.error("  trial #{trial + 1}: unhandled response:")
        UI.error(res[0..400])
        break
      end
    end

    UI.error("✗ Age rating failed after retries") unless success
  end

  desc "Create new App Review Information for AdblockKeshi via raw curl"
  lane :create_review_info_adblockkeshi do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )

    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    target = app.get_app_store_versions(limit: 3).find { |v| v.app_store_state == "PREPARE_FOR_SUBMISSION" }
    UI.user_error!("editable version not found") unless target
    UI.message("target version: v#{target.version_string} (id=#{target.id})")

    token_text = Spaceship::ConnectAPI.token.text
    require 'json'
    body = {
      data: {
        type: "appStoreReviewDetails",
        attributes: {
          contactFirstName: "Kureho",
          contactLastName: "Support",
          contactEmail: "info@kureho.app",
          contactPhone: "+81-REDACTED",
          demoAccountRequired: false,
          notes: "本アプリは Safari Content Blocker です。Safari 設定 > 機能拡張 > 「広告消し」を ON にして https://adblock-tester.com を開くと広告ブロック動作が確認できます。アプリ内画面は最小構成で、設定項目はありません。"
        },
        relationships: {
          appStoreVersion: {
            data: { type: "appStoreVersions", id: target.id }
          }
        }
      }
    }
    body_json = JSON.generate(body)
    # tmp file 経由で curl にデータ渡す (escape 問題回避)
    tmp = "/tmp/review-info-body.json"
    File.write(tmp, body_json)
    result = `curl -sS -X POST "https://api.appstoreconnect.apple.com/v1/appStoreReviewDetails" \
      -H "Authorization: Bearer #{token_text}" \
      -H "Content-Type: application/json" \
      --data-binary @#{tmp} 2>&1`
    UI.message("Response: #{result[0..500]}")
    if result.include?('"errors"')
      UI.error("Create failed")
    else
      UI.success("✓ Review Info created")
    end
  end

  desc "Migrate all apps' App Review Information to corp (info@kureho.app, Kureho/Support)"
  lane :migrate_all_review_info_to_corp do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )

    corp_attrs = {
      contactFirstName: "Kureho",
      contactLastName: "Support",
      contactEmail: "info@kureho.app"
      # Phone は既存維持 (kureho 判断)
      # Notes はアプリ固有なので維持
    }

    apps = Spaceship::ConnectAPI::App.all
    UI.message("対象アプリ数: #{apps.count}")
    success = []
    failed = []

    apps.each do |app|
      UI.message("---------- #{app.name} ----------")
      versions = app.get_app_store_versions(limit: 3)
      # PREPARE_FOR_SUBMISSION / WAITING_FOR_REVIEW / READY_FOR_SALE の editable な最新
      target = versions.find { |v| %w[PREPARE_FOR_SUBMISSION WAITING_FOR_REVIEW IN_REVIEW REJECTED DEVELOPER_REJECTED].include?(v.app_store_state) }
      target ||= versions.first
      if target.nil?
        UI.message("  バージョン無し → skip")
        next
      end

      UI.message("  target: v#{target.version_string} (#{target.app_store_state})")
      begin
        detail = target.fetch_app_store_review_detail
        if detail
          detail.update(attributes: corp_attrs)
          UI.success("  ✓ updated (existing)")
          success << "#{app.name} v#{target.version_string}"
        else
          UI.message("  Review Detail nil → skip (新規 ASC アプリのケース、別途作成必要)")
          failed << "#{app.name} (nil detail)"
        end
      rescue => e
        UI.error("  ✗ failed: #{e.message[0..120]}")
        failed << "#{app.name}: #{e.message[0..80]}"
      end
    end

    UI.message("")
    UI.message("========== 結果 ==========")
    UI.success("成功: #{success.count}")
    success.each { |s| UI.message("  ✓ #{s}") }
    UI.error("失敗: #{failed.count}") if failed.any?
    failed.each { |f| UI.message("  ✗ #{f}") }
  end

  desc "List all apps' App Review Information (連絡先 一覧)"
  lane :list_all_review_info do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )

    apps = Spaceship::ConnectAPI::App.all
    UI.message("総アプリ数: #{apps.count}")
    UI.message("")

    apps.each do |app|
      UI.message("========== #{app.name} (#{app.bundle_id}) ==========")
      versions = app.get_app_store_versions(limit: 5)
      if versions.empty?
        UI.message("  (バージョン無し)")
        next
      end

      versions.each do |v|
        begin
          detail = v.fetch_app_store_review_detail
          if detail.nil?
            UI.message("  v#{v.version_string} (#{v.app_store_state}): (Review Detail 無し)")
            next
          end
          UI.message("  v#{v.version_string} (#{v.app_store_state}):")
          UI.message("    First:  #{detail.contact_first_name}")
          UI.message("    Last:   #{detail.contact_last_name}")
          UI.message("    Email:  #{detail.contact_email}")
          UI.message("    Phone:  #{detail.contact_phone}")
          UI.message("    DemoReq: #{detail.demo_account_required}")
          UI.message("    DemoUser: #{detail.demo_account_name}")
          notes = (detail.notes || "")[0..200]
          UI.message("    Notes:  #{notes}")
          break  # 最新1つだけで十分
        rescue => e
          UI.message("  v#{v.version_string} (#{v.app_store_state}): エラー (#{e.message[0..80]})")
        end
      end
      UI.message("")
    end
  end

  desc "Patch description/keywords/url metadata directly (full text refresh)"
  lane :patch_metadata do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )
    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    versions = app.get_app_store_versions
    target = versions.find { |v| v.app_store_state == "PREPARE_FOR_SUBMISSION" } || versions.first
    UI.user_error!("editable version not found") unless target

    locs = target.get_app_store_version_localizations
    ja = locs.find { |l| l.locale == "ja" }
    UI.user_error!("ja localization not found") unless ja

    desc_text = File.read("metadata/ja/description.txt").strip
    kw_text   = File.read("metadata/ja/keywords.txt").strip
    rn_text   = File.read("metadata/ja/release_notes.txt").strip
    mkt_url   = File.read("metadata/ja/marketing_url.txt").strip
    sup_url   = File.read("metadata/ja/support_url.txt").strip
    UI.message("description len=#{desc_text.length}, keywords len=#{kw_text.length}")

    # whatsNew は初回バージョンで編集不可 → 除外
    ja.update(attributes: {
      description: desc_text,
      keywords: kw_text,
      marketingUrl: mkt_url,
      supportUrl: sup_url
    })
    UI.success("✓ description / keywords / urls 更新完了")
  end

  desc "Patch URLs directly via ASC API (bypass deliver's review_attachment_file bug)"
  lane :patch_urls do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID,
      issuer_id: ISSUER_ID,
      filepath: API_KEY_PATH
    )

    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    versions = app.get_app_store_versions
    target = versions.find { |v| v.app_store_state == "PREPARE_FOR_SUBMISSION" } || versions.first
    UI.user_error!("editable version not found") unless target

    locs = target.get_app_store_version_localizations
    ja = locs.find { |l| l.locale == "ja" }
    UI.user_error!("ja localization not found") unless ja

    UI.message("Patching ja localization (id=#{ja.id})...")
    ja.update(attributes: {
      marketingUrl: "https://kureho.app/apps/adblock-keshi",
      supportUrl: "https://kureho.app/contact?product=adblockkeshi"
    })
    UI.success("✓ URLs updated")
  end

  desc "List TestFlight builds for the app"
  lane :list_builds do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID,
      issuer_id: ISSUER_ID,
      filepath: API_KEY_PATH
    )
    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    UI.message("App: #{app.name} (id=#{app.id})")
    builds = app.get_builds(limit: 10, sort: "-uploadedDate")
    UI.message("Builds: #{builds.size}")
    builds.each do |b|
      UI.message("  - version=#{b.version} buildNumber=#{b.version} processingState=#{b.processing_state} uploadedDate=#{b.uploaded_date}")
    end
  end

  desc "Check current ASC state (versions / localizations / metadata)"
  lane :check_state do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID,
      issuer_id: ISSUER_ID,
      filepath: API_KEY_PATH
    )

    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    UI.message("App: #{app.name} (id=#{app.id})")

    # AppInfo (name/subtitle 等) は App 全体に紐づく
    app.get_app_infos.each do |info|
      UI.message("AppInfo: state=#{info.app_info_state}")
      info.get_app_info_localizations.each do |il|
        UI.message("  locale=#{il.locale}")
        UI.message("    name='#{il.name}'")
        UI.message("    subtitle='#{il.subtitle}'")
        UI.message("    privacyPolicyUrl=#{il.privacy_policy_url}"   ) if il.respond_to?(:privacy_policy_url)
      end
    end

    # AppStoreVersion (description/keywords/url 等) はバージョン単位
    versions = app.get_app_store_versions
    UI.message("Versions: #{versions.size}")
    versions.each do |v|
      UI.message("  version=#{v.version_string} state=#{v.app_store_state}")
      v.get_app_store_version_localizations.each do |l|
        UI.message("    locale=#{l.locale}")
        UI.message("      description_length=#{(l.description||'').length}")
        UI.message("      keywords='#{(l.keywords||'').slice(0,80)}...'")
        UI.message("      marketingUrl=#{l.marketing_url}")
        UI.message("      supportUrl=#{l.support_url}")
      end
    end
  end

desc "territories check via v1"
lane :verify_terr_v1 do
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: "8AQ38HX67R", issuer_id: "f75dec40-cdbc-4042-8faa-de413470def6",
    filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_8AQ38HX67R.p8")
  )
  app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
  token = Spaceship::ConnectAPI.token.text
  # v1 endpoint with sub-resource
  res = `curl -sS "https://api.appstoreconnect.apple.com/v1/apps/#{app.id}/appAvailabilityV2/availableTerritories?limit=200" -H "Authorization: Bearer #{token}"`
  require 'json'
  p = JSON.parse(res) rescue {}
  UI.message("territories count: #{p.dig('data')&.size || 0}")
  UI.message("first 5: #{p.dig('data')&.first(5)&.map{|t|t['id']}&.join(',')}")
end

end
