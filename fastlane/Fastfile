default_platform(:ios)

API_KEY_PATH = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_8AQ38HX67R.p8")
KEY_ID = "8AQ38HX67R"
ISSUER_ID = "f75dec40-cdbc-4042-8faa-de413470def6"

def asc_api_key
  app_store_connect_api_key(
    key_id: KEY_ID,
    issuer_id: ISSUER_ID,
    key_filepath: API_KEY_PATH,
    duration: 1200,
    in_house: false
  )
end

platform :ios do

  # ============================================================
  # 接続テスト: ASC API key の疎通確認（副作用なし、読み取りのみ）
  # ============================================================
  desc "ASC API key で接続テスト（既存アプリ一覧取得・副作用なし）"
  lane :test_connection do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID,
      issuer_id: ISSUER_ID,
      filepath: API_KEY_PATH
    )

    apps = Spaceship::ConnectAPI::App.all
    UI.message("==== ASC 接続成功 ====")
    UI.message("総アプリ数: #{apps.count}")
    apps.each do |app|
      UI.message("  - #{app.bundle_id} (#{app.name})")
    end

    # AdblockKeshi が既に存在するかチェック
    existing = apps.find { |a| a.bundle_id == "com.kureho.adblockkeshi" }
    if existing
      UI.important("⚠️  com.kureho.adblockkeshi は既に登録済: app_id=#{existing.id}")
    else
      UI.success("✓ com.kureho.adblockkeshi は未登録、produce 可能")
    end
  end

  # ============================================================
  # 不可逆: bundle id 登録のみ（ASC アプリ作成は Web UI 手動・後述）
  # ASC API は 'apps' リソースに対する CREATE をサポートしないため
  # ============================================================
  desc "[不可逆] bundle id 登録 (ASC API 経由・2FA不要)"
  lane :register_bundle_ids do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID,
      issuer_id: ISSUER_ID,
      filepath: API_KEY_PATH
    )

    %w[com.kureho.adblockkeshi com.kureho.adblockkeshi.blocker].each do |bundle_id|
      existing = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == bundle_id }
      if existing
        UI.message("✓ bundle id 既存: #{bundle_id} (id=#{existing.id})")
      else
        name = bundle_id == "com.kureho.adblockkeshi" ? "AdblockKeshi" : "AdblockKeshi ContentBlocker"
        Spaceship::ConnectAPI::BundleId.create(
          name: name,
          identifier: bundle_id,
          platform: "IOS",
          seed_id: "L455WPL8QZ"
        )
        UI.success("✓ bundle id 新規作成: #{bundle_id}")
      end
    end

    UI.message("")
    UI.message("==== 次に kureho の手動操作 (約30秒) ====")
    UI.message("ASC Web UI で新規アプリ作成:")
    UI.message("  https://appstoreconnect.apple.com/apps")
    UI.message("  → 「+」ボタン → 新規 App → iOS")
    UI.message("  - 名前: 広告消し")
    UI.message("  - 主要言語: 日本語")
    UI.message("  - バンドルID: com.kureho.adblockkeshi (上記で登録済)")
    UI.message("  - SKU: com.kureho.adblockkeshi.sku.001")
    UI.message("  - ユーザーアクセス: 限定アクセス")
  end

  # ============================================================
  # Build & TestFlight upload
  # ============================================================
  desc "Build, archive, upload to TestFlight"
  lane :beta do
    sh "cd .. && xcodegen generate"

    build_app(
      project: "AdblockKeshi.xcodeproj",
      scheme: "AdblockKeshi",
      export_method: "app-store",
      output_directory: "build",
      clean: true,
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: asc_api_key,
      skip_waiting_for_build_processing: false,
      changelog: "v0.2.0-plan-b 完了。Plan A+B 統合動作確認版。"
    )
  end

  # ============================================================
  # Metadata 送信（テキスト系のみ、スクショ・バイナリは別フェーズ）
  # ============================================================
  desc "Submit text metadata only (no screenshots, no binary, no review submission)"
  lane :submit_metadata do
    deliver(
      api_key: asc_api_key,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_screenshots: true,
      skip_metadata: false,
      skip_binary_upload: true,
      price_tier: 4,
      reset_ratings: false,
      run_precheck_before_submit: false
    )
  end

  desc "Submit screenshots only (after generation)"
  lane :submit_screenshots do
    deliver(
      api_key: asc_api_key,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_screenshots: false,
      skip_metadata: true,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      run_precheck_before_submit: false
    )
  end

  # ============================================================
  # 4点監査（feedback_apple_submission_state_audit）
  # ============================================================
  desc "Run 4-point audit (review/availability/price/IAP)"
  lane :audit do
    sh "python3 ../../tasks/scripts/audit_4points.py com.kureho.adblockkeshi || true"
  end

  desc "Clone Review Information from an existing app (StillCam) to AdblockKeshi"
  lane :clone_review_info do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )

    # Source: StillCam 4K (id=6760555855) の最新 version の Review Detail
    source_app = Spaceship::ConnectAPI::App.find("com.Kureho.MannerCamera4K")
    UI.user_error!("source app not found") unless source_app
    src_versions = source_app.get_app_store_versions
    src_target = src_versions.find { |v| v.app_store_state == "READY_FOR_SALE" } || src_versions.first
    src_detail = src_target.fetch_app_store_review_detail
    UI.message("Source review detail (StillCam):")
    UI.message("  email: #{src_detail.contact_email}")
    UI.message("  phone: #{src_detail.contact_phone[0..2]}***#{src_detail.contact_phone[-2..-1]} (masked)")
    UI.message("  first: #{src_detail.contact_first_name}")
    UI.message("  last:  #{src_detail.contact_last_name}")

    # Target: AdblockKeshi
    target_app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    target_versions = target_app.get_app_store_versions
    target_v = target_versions.find { |v| v.app_store_state == "PREPARE_FOR_SUBMISSION" } || target_versions.first
    UI.user_error!("editable version not found") unless target_v

    attrs = {
      contactFirstName: src_detail.contact_first_name,
      contactLastName: src_detail.contact_last_name,
      contactEmail: src_detail.contact_email,
      contactPhone: src_detail.contact_phone,
      demoAccountRequired: false,
      notes: "本アプリは Safari Content Blocker です。Safari 設定 > 機能拡張 > 「広告消し」を ON にして adblock-tester.com を開くと広告ブロック動作が確認できます。アプリ内画面は最小構成で、設定項目はありません。"
    }

    begin
      existing = target_v.fetch_app_store_review_detail
      existing.update(attributes: attrs)
      UI.success("✓ Review Information updated (existing)")
    rescue => e
      # 新規作成: Tunes クライアント経由で raw POST
      UI.message("Existing not found (#{e.message[0..100]}). Creating new via Tunes client...")
      body = {
        data: {
          type: "appStoreReviewDetails",
          attributes: attrs,
          relationships: {
            appStoreVersion: {
              data: { type: "appStoreVersions", id: target_v.id }
            }
          }
        }
      }
      Spaceship::ConnectAPI::Tunes.client.post("appStoreReviewDetails", body)
      UI.success("✓ Review Information created (Tunes raw POST)")
    end
  end

  desc "Set Primary Category (UTILITIES)"
  lane :set_category do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )
    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    app_info = app.fetch_edit_app_info || app.fetch_live_app_info
    UI.user_error!("app_info not found") unless app_info

    # Primary Category = UTILITIES
    app_info.update_categories(
      primary_category_id: "UTILITIES"
    )
    UI.success("✓ Primary Category = UTILITIES")
  end

  desc "Set Price (¥400 = price point JPY 400)"
  lane :set_price do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )
    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")

    # 新しい価格 API: AppPricePoint / AppPriceSchedule
    # ¥400 = USD$2.99 相当 = tier 3 相当 (旧)
    # 直接 fastlane action を使う
    versions = app.get_app_store_versions
    target = versions.find { |v| v.app_store_state == "PREPARE_FOR_SUBMISSION" } || versions.first
    UI.message("Setting price for version #{target.version_string}...")

    # ASC Web UI で行う方が確実な領域なので注意ログ
    UI.important("価格設定は ASC Web UI 推奨。fastlane deliver の price_tier 4 (=¥400) を使うか、ASC で手動設定")
    UI.message("https://appstoreconnect.apple.com/apps/#{app.id}/pricing")
  end

  desc "Create new App Review Information for AdblockKeshi via raw curl"
  lane :create_review_info_adblockkeshi do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )

    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    target = app.get_app_store_versions(limit: 3).find { |v| v.app_store_state == "PREPARE_FOR_SUBMISSION" }
    UI.user_error!("editable version not found") unless target
    UI.message("target version: v#{target.version_string} (id=#{target.id})")

    token_text = Spaceship::ConnectAPI.token.text
    require 'json'
    body = {
      data: {
        type: "appStoreReviewDetails",
        attributes: {
          contactFirstName: "Kureho",
          contactLastName: "Support",
          contactEmail: "info@kureho.app",
          contactPhone: "+81-REDACTED",
          demoAccountRequired: false,
          notes: "本アプリは Safari Content Blocker です。Safari 設定 > 機能拡張 > 「広告消し」を ON にして https://adblock-tester.com を開くと広告ブロック動作が確認できます。アプリ内画面は最小構成で、設定項目はありません。"
        },
        relationships: {
          appStoreVersion: {
            data: { type: "appStoreVersions", id: target.id }
          }
        }
      }
    }
    body_json = JSON.generate(body)
    # tmp file 経由で curl にデータ渡す (escape 問題回避)
    tmp = "/tmp/review-info-body.json"
    File.write(tmp, body_json)
    result = `curl -sS -X POST "https://api.appstoreconnect.apple.com/v1/appStoreReviewDetails" \
      -H "Authorization: Bearer #{token_text}" \
      -H "Content-Type: application/json" \
      --data-binary @#{tmp} 2>&1`
    UI.message("Response: #{result[0..500]}")
    if result.include?('"errors"')
      UI.error("Create failed")
    else
      UI.success("✓ Review Info created")
    end
  end

  desc "Migrate all apps' App Review Information to corp (info@kureho.app, Kureho/Support)"
  lane :migrate_all_review_info_to_corp do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )

    corp_attrs = {
      contactFirstName: "Kureho",
      contactLastName: "Support",
      contactEmail: "info@kureho.app"
      # Phone は既存維持 (kureho 判断)
      # Notes はアプリ固有なので維持
    }

    apps = Spaceship::ConnectAPI::App.all
    UI.message("対象アプリ数: #{apps.count}")
    success = []
    failed = []

    apps.each do |app|
      UI.message("---------- #{app.name} ----------")
      versions = app.get_app_store_versions(limit: 3)
      # PREPARE_FOR_SUBMISSION / WAITING_FOR_REVIEW / READY_FOR_SALE の editable な最新
      target = versions.find { |v| %w[PREPARE_FOR_SUBMISSION WAITING_FOR_REVIEW IN_REVIEW REJECTED DEVELOPER_REJECTED].include?(v.app_store_state) }
      target ||= versions.first
      if target.nil?
        UI.message("  バージョン無し → skip")
        next
      end

      UI.message("  target: v#{target.version_string} (#{target.app_store_state})")
      begin
        detail = target.fetch_app_store_review_detail
        if detail
          detail.update(attributes: corp_attrs)
          UI.success("  ✓ updated (existing)")
          success << "#{app.name} v#{target.version_string}"
        else
          UI.message("  Review Detail nil → skip (新規 ASC アプリのケース、別途作成必要)")
          failed << "#{app.name} (nil detail)"
        end
      rescue => e
        UI.error("  ✗ failed: #{e.message[0..120]}")
        failed << "#{app.name}: #{e.message[0..80]}"
      end
    end

    UI.message("")
    UI.message("========== 結果 ==========")
    UI.success("成功: #{success.count}")
    success.each { |s| UI.message("  ✓ #{s}") }
    UI.error("失敗: #{failed.count}") if failed.any?
    failed.each { |f| UI.message("  ✗ #{f}") }
  end

  desc "List all apps' App Review Information (連絡先 一覧)"
  lane :list_all_review_info do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )

    apps = Spaceship::ConnectAPI::App.all
    UI.message("総アプリ数: #{apps.count}")
    UI.message("")

    apps.each do |app|
      UI.message("========== #{app.name} (#{app.bundle_id}) ==========")
      versions = app.get_app_store_versions(limit: 5)
      if versions.empty?
        UI.message("  (バージョン無し)")
        next
      end

      versions.each do |v|
        begin
          detail = v.fetch_app_store_review_detail
          if detail.nil?
            UI.message("  v#{v.version_string} (#{v.app_store_state}): (Review Detail 無し)")
            next
          end
          UI.message("  v#{v.version_string} (#{v.app_store_state}):")
          UI.message("    First:  #{detail.contact_first_name}")
          UI.message("    Last:   #{detail.contact_last_name}")
          UI.message("    Email:  #{detail.contact_email}")
          UI.message("    Phone:  #{detail.contact_phone}")
          UI.message("    DemoReq: #{detail.demo_account_required}")
          UI.message("    DemoUser: #{detail.demo_account_name}")
          notes = (detail.notes || "")[0..200]
          UI.message("    Notes:  #{notes}")
          break  # 最新1つだけで十分
        rescue => e
          UI.message("  v#{v.version_string} (#{v.app_store_state}): エラー (#{e.message[0..80]})")
        end
      end
      UI.message("")
    end
  end

  desc "Patch description/keywords/url metadata directly (full text refresh)"
  lane :patch_metadata do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: API_KEY_PATH
    )
    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    versions = app.get_app_store_versions
    target = versions.find { |v| v.app_store_state == "PREPARE_FOR_SUBMISSION" } || versions.first
    UI.user_error!("editable version not found") unless target

    locs = target.get_app_store_version_localizations
    ja = locs.find { |l| l.locale == "ja" }
    UI.user_error!("ja localization not found") unless ja

    desc_text = File.read("metadata/ja/description.txt").strip
    kw_text   = File.read("metadata/ja/keywords.txt").strip
    rn_text   = File.read("metadata/ja/release_notes.txt").strip
    mkt_url   = File.read("metadata/ja/marketing_url.txt").strip
    sup_url   = File.read("metadata/ja/support_url.txt").strip
    UI.message("description len=#{desc_text.length}, keywords len=#{kw_text.length}")

    # whatsNew は初回バージョンで編集不可 → 除外
    ja.update(attributes: {
      description: desc_text,
      keywords: kw_text,
      marketingUrl: mkt_url,
      supportUrl: sup_url
    })
    UI.success("✓ description / keywords / urls 更新完了")
  end

  desc "Patch URLs directly via ASC API (bypass deliver's review_attachment_file bug)"
  lane :patch_urls do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID,
      issuer_id: ISSUER_ID,
      filepath: API_KEY_PATH
    )

    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    versions = app.get_app_store_versions
    target = versions.find { |v| v.app_store_state == "PREPARE_FOR_SUBMISSION" } || versions.first
    UI.user_error!("editable version not found") unless target

    locs = target.get_app_store_version_localizations
    ja = locs.find { |l| l.locale == "ja" }
    UI.user_error!("ja localization not found") unless ja

    UI.message("Patching ja localization (id=#{ja.id})...")
    ja.update(attributes: {
      marketingUrl: "https://kureho.app/apps/adblock-keshi",
      supportUrl: "https://kureho.app/contact?product=adblockkeshi"
    })
    UI.success("✓ URLs updated")
  end

  desc "List TestFlight builds for the app"
  lane :list_builds do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID,
      issuer_id: ISSUER_ID,
      filepath: API_KEY_PATH
    )
    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    UI.message("App: #{app.name} (id=#{app.id})")
    builds = app.get_builds(limit: 10, sort: "-uploadedDate")
    UI.message("Builds: #{builds.size}")
    builds.each do |b|
      UI.message("  - version=#{b.version} buildNumber=#{b.version} processingState=#{b.processing_state} uploadedDate=#{b.uploaded_date}")
    end
  end

  desc "Check current ASC state (versions / localizations / metadata)"
  lane :check_state do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID,
      issuer_id: ISSUER_ID,
      filepath: API_KEY_PATH
    )

    app = Spaceship::ConnectAPI::App.find("com.kureho.adblockkeshi")
    UI.message("App: #{app.name} (id=#{app.id})")

    # AppInfo (name/subtitle 等) は App 全体に紐づく
    app.get_app_infos.each do |info|
      UI.message("AppInfo: state=#{info.app_info_state}")
      info.get_app_info_localizations.each do |il|
        UI.message("  locale=#{il.locale}")
        UI.message("    name='#{il.name}'")
        UI.message("    subtitle='#{il.subtitle}'")
        UI.message("    privacyPolicyUrl=#{il.privacy_policy_url}"   ) if il.respond_to?(:privacy_policy_url)
      end
    end

    # AppStoreVersion (description/keywords/url 等) はバージョン単位
    versions = app.get_app_store_versions
    UI.message("Versions: #{versions.size}")
    versions.each do |v|
      UI.message("  version=#{v.version_string} state=#{v.app_store_state}")
      v.get_app_store_version_localizations.each do |l|
        UI.message("    locale=#{l.locale}")
        UI.message("      description_length=#{(l.description||'').length}")
        UI.message("      keywords='#{(l.keywords||'').slice(0,80)}...'")
        UI.message("      marketingUrl=#{l.marketing_url}")
        UI.message("      supportUrl=#{l.support_url}")
      end
    end
  end

end
