default_platform(:ios)

API_KEY_PATH = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_8AQ38HX67R.p8")
KEY_ID = "8AQ38HX67R"
ISSUER_ID = "f75dec40-cdbc-4042-8faa-de413470def6"

def asc_api_key
  app_store_connect_api_key(
    key_id: KEY_ID,
    issuer_id: ISSUER_ID,
    key_filepath: API_KEY_PATH,
    duration: 1200,
    in_house: false
  )
end

platform :ios do

  # ============================================================
  # 接続テスト: ASC API key の疎通確認（副作用なし、読み取りのみ）
  # ============================================================
  desc "ASC API key で接続テスト（既存アプリ一覧取得・副作用なし）"
  lane :test_connection do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID,
      issuer_id: ISSUER_ID,
      filepath: API_KEY_PATH
    )

    apps = Spaceship::ConnectAPI::App.all
    UI.message("==== ASC 接続成功 ====")
    UI.message("総アプリ数: #{apps.count}")
    apps.each do |app|
      UI.message("  - #{app.bundle_id} (#{app.name})")
    end

    # AdblockKeshi が既に存在するかチェック
    existing = apps.find { |a| a.bundle_id == "com.kureho.adblockkeshi" }
    if existing
      UI.important("⚠️  com.kureho.adblockkeshi は既に登録済: app_id=#{existing.id}")
    else
      UI.success("✓ com.kureho.adblockkeshi は未登録、produce 可能")
    end
  end

  # ============================================================
  # 不可逆: App ID 登録 + ASC アプリ作成（kureho の GO サイン後のみ）
  # ============================================================
  desc "[不可逆] App ID + ASC アプリ作成"
  lane :create_app do
    produce(
      app_identifier: "com.kureho.adblockkeshi",
      app_name: "広告消し",
      language: "ja-JP",
      app_version: "1.0.0",
      sku: "com.kureho.adblockkeshi.sku.001",
      team_id: "L455WPL8QZ",
      itc_team_id: "L455WPL8QZ",
      skip_devcenter: false,
      skip_itc: false,
      enable_services: {
        app_group: "on"
      }
    )

    # Extension の App ID
    produce(
      app_identifier: "com.kureho.adblockkeshi.blocker",
      app_name: "広告消し Content Blocker",
      language: "ja-JP",
      sku: "com.kureho.adblockkeshi.blocker.sku.001",
      team_id: "L455WPL8QZ",
      itc_team_id: "L455WPL8QZ",
      skip_devcenter: false,
      skip_itc: true,  # Extension は ASC アプリ不要
      enable_services: {
        app_group: "on"
      }
    )
  end

  # ============================================================
  # Build & TestFlight upload
  # ============================================================
  desc "Build, archive, upload to TestFlight"
  lane :beta do
    sh "cd .. && xcodegen generate"

    build_app(
      project: "AdblockKeshi.xcodeproj",
      scheme: "AdblockKeshi",
      export_method: "app-store",
      output_directory: "build",
      clean: true,
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: asc_api_key,
      skip_waiting_for_build_processing: false,
      changelog: "v0.2.0-plan-b 完了。Plan A+B 統合動作確認版。"
    )
  end

  # ============================================================
  # Metadata + screenshot 送信
  # ============================================================
  desc "Submit metadata + screenshots (does NOT submit for review)"
  lane :submit_metadata do
    deliver(
      api_key: asc_api_key,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_screenshots: false,
      skip_metadata: false,
      skip_binary_upload: true,
      price_tier: 4,
      reset_ratings: false,
      release_notes: { "ja" => "初回リリース。Safariの全画面広告をシンプルにブロック。" }
    )
  end

  # ============================================================
  # 4点監査（feedback_apple_submission_state_audit）
  # ============================================================
  desc "Run 4-point audit (review/availability/price/IAP)"
  lane :audit do
    sh "python3 ../../tasks/scripts/audit_4points.py com.kureho.adblockkeshi || true"
  end

end
