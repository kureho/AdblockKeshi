<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.kureho.adblockkeshi.shared</string>
    </array>
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)group.com.kureho.adblockkeshi.shared</string>
    </array>
    <!-- iCloud KVS: grandfather 権利の再インストール/機種変耐性（ProEntitlementCache の3冗長目）。
         ★kureho 操作要★ Apple Developer で App ID に iCloud capability(Key-Value storage) を有効化 + プロビジョニング再生成が必要。 -->
    <key>com.apple.developer.ubiquity-kvstore-identifier</key>
    <string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
    <!-- 本体が NETunnelProviderManager で DNS トンネルを構成/起動するため（Chunk 3）。 -->
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>packet-tunnel-provider</string>
    </array>
</dict>
</plist>
