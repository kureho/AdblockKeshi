{
  "name": "adblockkeshi-reports-workers",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Cloudflare Workers backend for AdblockKeshi v3.0 (report receiving + rule pipeline). 0-yen hard cap enforced (memory feedback_no_silent_paid_infra).",
  "scripts": {
    "dev": "wrangler dev --local",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply adblockkeshi-reports --local",
    "db:migrate:prod": "wrangler d1 migrations apply adblockkeshi-reports --remote",
    "db:exec:local": "wrangler d1 execute adblockkeshi-reports --local --command",
    "db:exec:prod": "wrangler d1 execute adblockkeshi-reports --remote --command"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.5.0",
    "@cloudflare/workers-types": "^4.20260606.1",
    "typescript": "^6.0.3",
    "vitest": "2.0.5",
    "wrangler": "^4.98.0"
  }
}
